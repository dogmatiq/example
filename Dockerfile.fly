# This Dockerfile is used to build the application for deployment on Fly.io. It
# uses a multi-stage build to create a statically linked binary that can run in
# a scratch container.
#
# It is not built using the http://makefiles.dev build system.

FROM golang:latest AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Build a statically linked application without CGO.
RUN CGO_ENABLED=0 GOOS=linux go build -o /bank ./cmd/bank

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /bank /usr/local/bin/bank
ENTRYPOINT ["bank"]
